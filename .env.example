# Copy to .env. .env is gitignored and must never be committed.

# Generation: any OpenAI-compatible endpoint.
RAG_BASE_URL=http://localhost:8080/v1   # any OpenAI-compatible /chat/completions
RAG_MODEL=deepseek-v4.1-flash
RAG_API_KEY=            # required, or OPENAI_API_KEY

# Retrieval. Changing RAG_EMBED_MODEL invalidates every stored vector:
# POST /reindex afterwards or search raises a dimension mismatch.
RAG_EMBED_MODEL=BAAI/bge-small-zh-v1.5

# Tuning, from the measured calibration in SPEC.md 修订 1 and 修订 2.
# min_score 0.50 is a coarse scope gate, not a truth test; top_k 6 is the
# evidence set handed to the model.
RAG_TOP_K=6
RAG_MIN_SCORE=0.50

RAG_DOCS_DIR=docs
RAG_DB_PATH=data/index.db
